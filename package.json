{
  "name": "flow-browser",
  "version": "1.1.8",
  "description": "A minimal, fast, and secure web browser built with React Native and Electron.",
  "author": "Flowr Browser Team",
  "main": "src/main/main.js",
  "scripts": {
    "start": "webpack serve --config webpack.renderer.config.js --mode development",
    "electron": "wait-on http://localhost:8081 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently \"npm start\" \"npm run electron\"",
    "build": "webpack --config webpack.renderer.config.js --mode production",
    "test:adblock": "node tests/adblock.test.js",
    "test:updater": "node tests/updater.test.js",
    "test:importer": "node tests/importer.test.js",
    "test:privacy": "node tests/privacy.test.js",
    "dist": "npm run build && electron-builder",
    "dist:win:update": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:mac:all": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "build": {
    "appId": "com.flow.browser",
    "productName": "Flowr",
    "artifactName": "Flowr-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "directories": {
      "output": "release_v5"
    },
    "icon": "build/icons/flowr-transparent.png",
    "publish": [
      {
        "provider": "github",
        "owner": "Tiedr",
        "repo": "flowr-browser",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "!src/main/**/config.local.js",
      "!src/main/**/*.local.js",
      "package.json",
      "build/icons/flowr-transparent.png"
    ],
    "win": {
      "icon": "build/icons/flowr-transparent.png",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Network;WebBrowser",
      "synopsis": "A calmer, private browser by Tieddr",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.18.6",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^6.7.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.5.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native-web": "^0.19.0",
    "style-loader": "^3.3.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^4.11.0"
  }
}
